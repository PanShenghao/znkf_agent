# ==========================================================
# znkf_agent 配置模板（复制为 agent/.env 并填入真实值）
# 注意：.env 已被 .gitignore 忽略，切勿提交真实密钥。
# ==========================================================

# ---- LLM（通义千问，OpenAI 兼容接口）----
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
MODEL=qwen-plus
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 存储（本地默认；容器化时改成服务名，如 redis/milvus/neo4j/mysql）----
REDIS_URL=redis://localhost:6379
MILVUS_HOST=localhost
MILVUS_PORT=19530
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cloudagent123
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=digital_shop

# ---- 安全（最小鉴权；生产必须配置强随机串）----
AUTH_SECRET=please-change-me-to-a-long-random-string
AUTH_TOKEN_TTL=86400

# ---- 熔断 / 重试 ----
CB_FAILURE_THRESHOLD=3
CB_RESET_TIMEOUT=60
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
HUMAN_ESCALATION_THRESHOLD=3

# ---- 转人工 → Chatwoot（可选，留空则仅写 MySQL 队列）----
CHATWOOT_URL=http://localhost:3000
CHATWOOT_ACCESS_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_INBOX_ID=

# ---- 可观测 / 计费（token 单价快照，元/百万 token，请查最新价覆盖）----
LLM_INPUT_PRICE_PER_1M=0.8
LLM_OUTPUT_PRICE_PER_1M=2.0

LOG_LEVEL=INFO
