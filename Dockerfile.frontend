# 前端镜像：多阶段构建（node 构建 → nginx 托管 + 反向代理后端）
FROM node:20-alpine AS build
WORKDIR /build
COPY front/package*.json ./
RUN npm install
COPY front/ ./
RUN npm run build

FROM nginx:alpine
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist /usr/share/nginx/html
EXPOSE 80
