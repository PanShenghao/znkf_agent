# ==========================================================
# docker-compose 环境变量模板（复制为 .env 并填入真实值）
# .env 已被 .gitignore 忽略，切勿提交真实密钥。
# 用法：docker compose up -d --build
# ==========================================================

# 必填：通义千问 API Key（LLM + Embedding 都用它）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
MODEL=qwen-plus
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 基础设施（可改）
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=digital_shop
NEO4J_AUTH=neo4j/cloudagent123

# 鉴权（生产务必改成强随机串）
AUTH_SECRET=please-change-me-to-a-long-random-string

# 转人工 → Chatwoot（可选；留空则仅落 MySQL 队列）
# CHATWOOT_URL=http://localhost:3000
# CHATWOOT_ACCESS_TOKEN=
# CHATWOOT_ACCOUNT_ID=
# CHATWOOT_API_INBOX_ID=
